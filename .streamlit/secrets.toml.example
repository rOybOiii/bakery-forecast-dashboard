# Copy this file to secrets.toml locally, or enter the same values in the
# hosted Streamlit secret manager. Never commit the real values.
[auth]
expose_tokens = "access"
redirect_uri = "https://app.credib.ly/oauth2callback"
cookie_secret = "replace-with-a-long-random-secret"
client_id = "replace-with-your-auth0-client-id"
client_secret = "replace-with-your-auth0-client-secret"
server_metadata_url = "https://login.credib.ly/.well-known/openid-configuration"
client_kwargs = { "audience" = "https://api.credib.ly", "scope" = "openid profile email" }

# For local development, change redirect_uri to the localhost callback registered
# in Auth0. Streamlit sends only the exposed API access token to this service.
# The gateway, rather than Streamlit, owns database access and authorization.
[credent]
api_url = "https://api.credib.ly"
